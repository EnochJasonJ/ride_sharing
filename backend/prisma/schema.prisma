generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  engineType   = "client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PASSENGER
  DRIVER
  ADMIN
}

enum RideRequestStatus {
  REQUESTED
  MATCHING
  ASSIGNED
  CANCELLED
}

enum TripStatus {
  NOT_STARTED
  STARTED
  COMPLETED
  CANCELLED
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  role     Role   @default(PASSENGER)
  name     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driverProfile DriverProfile?
  rideRequests RideRequest[]
}

model DriverProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  isAvailable   Boolean   @default(false)
  latitude      Float     @default(0)
  longitude     Float     @default(0)
  vehicleId     String?   @unique
  vehicle       Vehicle?   @relation(fields: [vehicleId], references: [id])
  trips         Trip[]
  updatedAt     DateTime @updatedAt
}

model Vehicle {
  id           String   @id @default(uuid())
  make         String
  model        String
  plateNumber  String   @unique
  color        String
  driverProfile DriverProfile?
}

model RideRequest {
  id             String            @id @default(uuid())
  passengerId    String
  passenger      User              @relation(fields: [passengerId], references: [id])
  pickupLat      Float
  pickupLng      Float
  dropoffLat     Float
  dropoffLng     Float
  status         RideRequestStatus @default(REQUESTED)
  estimatedFare  Decimal           @db.Decimal(10, 2)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  trip           Trip?
}

model Trip {
  id               String     @id @default(uuid())
  rideRequestId    String     @unique
  rideRequest      RideRequest @relation(fields: [rideRequestId], references: [id])
  driverProfileId  String
  driverProfile    DriverProfile @relation(fields: [driverProfileId], references: [id])
  status           TripStatus @default(NOT_STARTED)
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  fare             Fare?
}

model Fare {
  id        String @id @default(uuid())
  tripId    String @unique
  trip      Trip   @relation(fields: [tripId], references: [id])
  amount    Decimal @db.Decimal(10, 2)
  currency  String @default("USD")
  createdAt DateTime @default(now())
}

model Payment {
  id        String   @id @default(uuid())
  fareId    String
  amount    Decimal  @db.Decimal(10, 2)
  status    String   @default("PENDING") // PENDING, COMPLETED, FAILED
  createdAt DateTime @default(now())
}
